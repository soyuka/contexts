{
    "name": "soyuka/contexts",
    "description": "Behatch contexts",
    "keywords": ["BDD", "Behat", "Symfony2", "Context"],
    "type": "library",
    "license": "beerware",

    "require": {
        "php": ">=8.1",
        "behat/behat": "^3.20 || ^4.0",
        "friends-of-behat/mink-extension": "^2.3.1 || ^3.0",
        "justinrainbow/json-schema": "^5.0|^6.0",
        "symfony/property-access": "^2.3|^3.0|^4.0|^5.0|^6.0|^7.0|^8.0",
        "symfony/http-foundation": "^2.3|^3.0|^4.0|^5.0|^6.0|^7.0|^8.0",
        "symfony/dom-crawler": "^2.4|^3.0|^4.0|^5.0|^6.0|^7.0|^8.0"
    },

    "require-dev": {
        "behat/mink-browserkit-driver": "^2.2",
        "behat/mink-selenium2-driver": "^1.6",
        "atoum/atoum": "^4.0",
        "phpunit/phpunit": "^9.5",
        "atoum/stubs": "^2.6",
        "symfony/http-client": "^5.4|^6.4|^7.0|^8.0",
        "symfony/mime": "^5.4|^6.4|^7.0|^8.0"
    },

    "autoload": {
        "psr-4": {
            "Behatch\\": "src/",
            "Behatch\\Tests\\Units\\": "tests/units/"
        }
    },

    "config": {
        "bin-dir": "bin/"
    },

    "replace": {
        "sanpi/behatch-contexts": "self.version"
    },

    "extra": {
        "branch-alias": {
            "dev-master": "3.0.x-dev"
        }
    }
}
